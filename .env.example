# Deployment key: a NEW key used only to pay the deployment, with no permission on ChainIntegrate's
# Universal Profile. Keep it only on the server that deploys; never commit the real .env.
DEPLOYER_KEY=
# ChainIntegrate's Universal Profile on the target network: it becomes the owner of the contracts and
# the creator shown on Universal Everything (LSP4Creators[]).
OWNER_UP=
# Optional: the arbiter key for disputes (VehicleRegistry), can also be set later by OWNER_UP.
ARBITER=
